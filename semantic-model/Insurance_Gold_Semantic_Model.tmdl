			measure 'Total Payments' =
					
					SUM ( fact_payment[payment_amount] )
				formatString: #,0.00
				displayFolder: Payments
				lineageTag: 987f164a-d0f3-469c-b028-cff612cac94a

				changedProperty = Name

				changedProperty = FormatString

				changedProperty = DisplayFolder

			measure 'Payment Count' =
					
					DISTINCTCOUNT ( fact_payment[payment_id] )
				formatString: #,0
