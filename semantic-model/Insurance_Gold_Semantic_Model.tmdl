				lineageTag: f80bd82a-9db3-4346-b8d9-5a333c93bf7c

				changedProperty = Name

				changedProperty = FormatString

				changedProperty = DisplayFolder

			measure 'Average Payment Amount' =
					
					AVERAGE ( fact_payment[payment_amount] )
				formatString: #,0.00
				displayFolder: Payments
				lineageTag: b4c3aea5-88a1-4fe5-8021-d1c2bba1654a

				changedProperty = Name

				changedProperty = FormatString

				changedProperty = DisplayFolder

			measure 'Paid-to-Claim Ratio' =
					
					DIVIDE (
					    [Total Payments],
					    [Total Claim Amount],
					    0
					)
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Payments
				lineageTag: a38d202f-c1cd-456a-a818-63fec2e0ced9

				changedProperty = Name

				changedProperty = FormatString

				changedProperty = DisplayFolder

			measure 'Total Payments YTD' =
					
					TOTALYTD (
					    [Total Payments],
					    dim_date[full_date]
					)
				formatString: #,0.00
				displayFolder: Time Intelligence
				lineageTag: 3eeeb3c3-375c-493f-ab95-77b067394347

				changedProperty = Name

				changedProperty = FormatString

				changedProperty = DisplayFolder

			measure 'Total Payments PY' =
					
					CALCULATE (
					    [Total Payments],
					    SAMEPERIODLASTYEAR ( dim_date[full_date] )
					)
				formatString: #,0.00
				displayFolder: Time Intelligence
				lineageTag: 6ad2a8ea-f715-4158-aff5-8d2de5b890d0

				changedProperty = Name

				changedProperty = FormatString

				changedProperty = DisplayFolder

			measure 'Payment YoY %' =
					
					DIVIDE (
					    [Total Payments] - [Total Payments PY],
					    [Total Payments PY],
					    0
					)
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Time Intelligence
				lineageTag: d0526e09-f9a7-481c-8373-b9b5aa3da734

				changedProperty = Name

				changedProperty = FormatString

				changedProperty = DisplayFolder

