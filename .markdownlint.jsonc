{
  // Portfolio docs favour readability over strict style; disable the noisy rules.
  "default": true,
  "MD013": false, // line length
  "MD024": { "siblings_only": true }, // duplicate headings allowed across sections
  "MD033": false, // inline HTML (badges, <br/> in mermaid)
  "MD041": false, // first line in file may be a badge block, not H1
  "MD046": false  // mixed code block styles (fenced + indented)
}
